<!DOCTYPE html>
<html lang="en">
     <head>
          <title>Image Grid</title>
     </head>
     <style>
        /* Reset margins and paddings */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  background-color: white;
  padding: 20px;
}

/* 3-Column Grid Container */
.grid-container {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-auto-rows: minmax(150px, auto);
  gap: 12px; /* Controls the spacing between images */
  max-width: 1000px;
  width: 100%;
}

/* Common image wrapper style */
.grid-item {
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.grid-item img {
  width: 100%;
  height: 100%;
  object-fit: cover; /* Ensures images crop nicely without distorting */
  display: block;
}

.item-1 {
  grid-column: 1;
  grid-row: 1 / span 3;
}

.item-2 {
  grid-column: 2;
  grid-row: 1 / span 1; 
}

.item-3 {
  grid-column: 1;
  grid-row: 4 / span 2; 
}

.item-4 {
  grid-column: 2;
  grid-row: 2 / span 4; 
}

.item-5 {
  grid-column: 3;
  grid-row: 1 / span 4; 
}

.item-6 {
  grid-column: 3;
  grid-row: 5 / span 1; 
}

     </style>
     <body>
          <div class="grid-container">
          <div class="grid-item item-1">
               <img src="Phone storage/Pictures/1788690139460.jpg">     
          </div>
          <div class="grid-item item-2">
          <img src="Phone storage/Pictures/296cf1a7-47d9-4854-a370-6293bd36fc94.jpg">
          </div>
          <div class="grid-item item-3">
          <img src="Phone storage/Pictures/1788690196016.jpg">
          </div>
          <div class="grid-item item-4">
          <img src="Phone storage/Pictures/bb7ad625-851e-445c-81e3-af9cecffd28a.jpg">
          </div>
          <div class="grid-item item-5">
          <img src="Phone storage/Pictures/296cf1a7-47d9-4854-a370-6293bd36fc94.jpg">
          </div>
          <div class="grid-item item-6">
          <img src="Phone storage/Pictures/1789730641718.jpg">
          </div>
          </div>
     </body>
</html>
